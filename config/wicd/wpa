name = WPA 1/2 (Passphrase)
author = Adam Blackburn
version = 1
require key *Key
-----
ctrl_interface=/var/run/wpa_supplicant
eapol_version=1
ap_scan=1
network={
       ssid="$_ESSID"
       scan_ssid=$_SCAN
       proto=RSN
       key_mgmt=WPA-PSK
       pairwise=CCMP
       group=CCMP
       psk=$_PSK
}
